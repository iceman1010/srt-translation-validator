{
    "name": "srt/translation-validator",
    "description": "Validates subtitle translations: detects missing captions, partial translation, untranslated copies, foreign-script characters, timestamp mismatch, and invalid SRT/WebVTT format",
    "keywords": ["subtitles", "srt", "webvtt", "translation", "validator"],
    "require": {
        "php": "^7.4|^8.0",
        "mantas-done/subtitles": "^1.0",
        "patrickschur/language-detection": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "SrtValidator\\": "src/"
        }
    },
    "bin": [
        "bin/srt-validator"
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "scripts": {
        "test": "phpunit tests/",
        "build-phar": "@php -d phar.readonly=0 build/build-phar.php"
    }
}